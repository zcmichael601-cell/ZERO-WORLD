<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="统一Harness下的AI搜索与AI推荐" name="统一Harness下的AI搜索与AI推荐"><mxGraphModel grid="1" page="1" pageWidth="1900" pageHeight="1670"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;02 / 建议架构：统一 Harness，复用搜索推荐数据面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;以下为本项目目标设计，不是任一厂商部署事实；实线为在线依赖，虚线为离线产物 / 反馈。&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#AAB9C8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1780" height="110" as="geometry"/></mxCell>
<mxCell id="entry" value="&lt;b style=&quot;font-size:24px&quot;&gt;消费者入口｜搜索框 / 会话 / 商品页 / 推荐流&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;登录态、页面实体、实时意图；可信商品卡、追问、反馈和确认页&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="1260" height="100" as="geometry"/></mxCell>
<mxCell id="intent" value="&lt;b style=&quot;font-size:24px&quot;&gt;统一任务意图与上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;显式硬约束 + 会话目标 + 授权偏好 + 证据 / 候选引用&lt;br&gt;按复杂度分流：快速检索、受控多步搜索、深度研究&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="1260" height="120" as="geometry"/></mxCell>
<mxCell id="harness" value="&lt;b style=&quot;font-size:24px&quot;&gt;Harness｜LLM + Prompt + Skill + Runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;按需披露、状态机、工具白名单、轮次/成本预算、取消恢复&lt;br&gt;模型决定下一步；程序与业务域决定能否执行、何时算完成&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#75AA92;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="530" width="1260" height="130" as="geometry"/></mxCell>
<mxCell id="search" value="&lt;b style=&quot;font-size:24px&quot;&gt;AI 搜索能力&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Query Plan / 改写 / 约束编译&lt;br&gt;商品多路检索、混合检索&lt;br&gt;证据获取与不足时继续查&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="750" width="370" height="150" as="geometry"/></mxCell>
<mxCell id="rec" value="&lt;b style=&quot;font-size:24px&quot;&gt;AI 推荐能力&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;授权偏好 + 当前任务&lt;br&gt;多路召回 / 排序 / 集合重排&lt;br&gt;适配解释与可控探索&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F2EDFC;strokeColor=#A28BC8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="750" width="370" height="150" as="geometry"/></mxCell>
<mxCell id="rag" value="&lt;b style=&quot;font-size:24px&quot;&gt;RAG 与外部知识&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;政策/说明/评价证据&lt;br&gt;ACL、有效期、引用、撤回&lt;br&gt;网页发现与正文读取分离&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CDAC79;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="750" width="370" height="150" as="geometry"/></mxCell>
<mxCell id="data" value="&lt;b style=&quot;font-size:24px&quot;&gt;共享搜推与商品数据面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;倒排 / 向量 / 行为 / 图谱召回 + 排序模型 + Feature Store&lt;br&gt;商品实体服务、实时价格库存、实验与曝光日志；最终硬约束过滤&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CDAC79;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="995" width="1260" height="125" as="geometry"/></mxCell>
<mxCell id="reply" value="&lt;b style=&quot;font-size:24px&quot;&gt;Reply｜证据与实体双重校验后交付&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;文字解释引用 evidenceRef；商品卡按 candidateSetId + skuId 填充&lt;br&gt;进度来自真实事件；“点击/喜欢/不喜欢”写入可追溯反馈&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="1200" width="1260" height="120" as="geometry"/></mxCell>
<mxCell id="offline" value="&lt;b style=&quot;font-size:24px&quot;&gt;离线学习与知识管道&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;数据同意/治理 → 文档/特征/标签 → 召回与排序训练 / LLM 蒸馏 → 评测 → 发布&lt;br&gt;语义 ID 生成式召回仅作候选路线实验；不允许在线自动改生产策略&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#AAB9C8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="1400" width="1260" height="120" as="geometry"/></mxCell>
<mxCell id="policy" value="&lt;b style=&quot;font-size:24px&quot;&gt;控制平面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Prompt / Skill / Tool / Model&lt;br&gt;Index / Ranker 统一版本&lt;br&gt;证据覆盖、线上实验、成本&lt;br&gt;安全与发布门禁&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#AAB9C8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1430" y="190" width="380" height="245" as="geometry"/></mxCell>
<mxCell id="tools" value="&lt;b style=&quot;font-size:24px&quot;&gt;Tool Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;所有业务 Tool 调用统一校验&lt;br&gt;身份、schema、scope&lt;br&gt;超时、重试、审计与契约&lt;br&gt;禁止任意数据库/网络访问&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#75AA92;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1430" y="525" width="380" height="245" as="geometry"/></mxCell>
<mxCell id="trade" value="&lt;b style=&quot;font-size:24px&quot;&gt;独立交易状态机&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;选购建议 ≠ 交易授权&lt;br&gt;报价 → 用户确认 → 幂等执行&lt;br&gt;结果未知 → 查单/对账&lt;br&gt;支付交给可信支付系统&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FCEDEA;strokeColor=#CB9991;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1430" y="870" width="380" height="245" as="geometry"/></mxCell>
<mxCell id="metrics" value="&lt;b style=&quot;font-size:24px&quot;&gt;双指标闭环&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;检索相关性 / 推荐效用&lt;br&gt;+ 事实一致性 / 安全&lt;br&gt;+ 时延 / 成本 / 长期满意&lt;br&gt;不只看对话轮次或 CTR&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#AAB9C8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1430" y="1210" width="380" height="245" as="geometry"/></mxCell>
