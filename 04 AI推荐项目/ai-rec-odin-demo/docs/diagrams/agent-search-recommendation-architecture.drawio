<mxCell id="edge-4" value="推荐 Skill" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="harness" target="rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-5" value="知识 / 研究 Skill" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="harness" target="rag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-6" value="检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="search" target="data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-7" value="召回与排序" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rec" target="data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-8" value="实体关联" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="rag" target="data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-9" value="候选 + 实时事实" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="data" target="reply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-10" value="曝光与授权反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reply" target="offline"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-11" value="受控发布" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="offline" target="data"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="1460"/><mxPoint x="30" y="1057"/></Array></mxGeometry></mxCell>
<mxCell id="edge-12" value="统一执行策略" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="tools" target="harness"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-13" value="仅传已验证购买意图" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.35;entryX=0;entryY=0.85;" edge="1" parent="1" source="reply" target="trade"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-14" value="版本 / 预算" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.1;" edge="1" parent="1" source="policy" target="harness"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="312"/><mxPoint x="1370" y="543"/></Array></mxGeometry></mxCell>
