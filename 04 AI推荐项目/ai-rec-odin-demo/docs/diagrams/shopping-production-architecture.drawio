<mxCell id="edge-8" value="发现 / 校价" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#68819B;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tool" target="search"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="607" y="870"/><mxPoint x="275" y="870"/></Array></mxGeometry></mxCell>
