<mxCell id="edge-12" value="执行账本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#68819B;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="transaction" target="state"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
