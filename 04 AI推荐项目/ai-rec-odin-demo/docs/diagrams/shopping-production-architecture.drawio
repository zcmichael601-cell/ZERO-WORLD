<mxfile host="app.diagrams.net" type="device"><diagram id="C端购物Agent生产目标架构" name="C端购物Agent生产目标架构"><mxGraphModel grid="1" page="1" pageWidth="1900" pageHeight="1680"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b style=&quot;font-size:23px&quot;&gt;01 / C 端购物 Agent · 生产目标架构（建议方案，非当前部署）&lt;/b&gt;" style="text;fillOpacity=0;strokeOpacity=0;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#9BAFBF;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="65" as="geometry"/></mxCell>
<mxCell id="subtitle" value="&lt;b style=&quot;font-size:23px&quot;&gt;LLM 提出决策 · Harness 管理执行 · 业务系统掌握事实与交易权威&lt;/b&gt;" style="text;fillOpacity=0;strokeOpacity=0;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#9BAFBF;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="1300" height="45" as="geometry"/></mxCell>
<mxCell id="client" value="&lt;b style=&quot;font-size:23px&quot;&gt;渠道与体验｜APP / H5 / Web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;对话 + 商品卡片 + 可信确认页 / 支付页&lt;br&gt;流式进度、取消、重连、人工客服入口&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#779ED2;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="155" width="1300" height="100" as="geometry"/></mxCell>
<mxCell id="bff" value="&lt;b style=&quot;font-size:23px&quot;&gt;接入层｜API Gateway + BFF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;登录态、账户隔离、风控、限流、请求去重&lt;br&gt;服务端派生 userId / scopes；生成 requestId / runId&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#779ED2;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="1300" height="100" as="geometry"/></mxCell>
<mxCell id="context" value="&lt;b style=&quot;font-size:23px&quot;&gt;Context + Prompt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Base / Business / 请求快照&lt;br&gt;多轮约束、实体、Memory&lt;br&gt;知识是证据，不是指令&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#779ED2;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="465" width="390" height="130" as="geometry"/></mxCell>
<mxCell id="runtime" value="&lt;b style=&quot;font-size:23px&quot;&gt;Harness / Agent Runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;持久化状态机 + Agent Loop&lt;br&gt;预算、暂停 / 恢复、Hooks&lt;br&gt;鉴权、确认、结果和错误回填&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#6AA68A;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="525" y="465" width="410" height="130" as="geometry"/></mxCell>
<mxCell id="skills" value="&lt;b style=&quot;font-size:23px&quot;&gt;能力注册与渐进披露&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Skill：经审核的 SOP&lt;br&gt;Tool：带权限的 schema&lt;br&gt;SubAgent：受限专业委派&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#6AA68A;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="990" y="465" width="390" height="130" as="geometry"/></mxCell>
<mxCell id="model" value="&lt;b style=&quot;font-size:23px&quot;&gt;LLM Gateway｜Spring AI 适配&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;复用现有模型接入起步&lt;br&gt;流式生成、工具调用协议&lt;br&gt;模型路由 / 配额 / 超时 / 熔断&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F2EDFC;strokeColor=#A08BC8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="675" width="390" height="140" as="geometry"/></mxCell>
<mxCell id="tool" value="&lt;b style=&quot;font-size:23px&quot;&gt;Tool Gateway｜策略执行点&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;schema + 身份 + scopes&lt;br&gt;只读并行 / 写操作确认与幂等&lt;br&gt;deadline、审计、结构化结果&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#6AA68A;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="525" y="675" width="410" height="140" as="geometry"/></mxCell>
<mxCell id="reply" value="&lt;b style=&quot;font-size:23px&quot;&gt;Reply｜可信交付&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;文本安全分段输出&lt;br&gt;商品实体引用 → 业务卡片&lt;br&gt;事实 / 状态校验 + SSE 事件&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#779ED2;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="990" y="675" width="390" height="140" as="geometry"/></mxCell>
<mxCell id="search" value="&lt;b style=&quot;font-size:23px&quot;&gt;商品发现与推荐域&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;搜索 / 召回 / 排序 / 画像&lt;br&gt;权威 SKU、价格、库存&lt;br&gt;LLM 解释，不替代排序引擎&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CEAA71;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="920" width="390" height="135" as="geometry"/></mxCell>
<mxCell id="knowledge" value="&lt;b style=&quot;font-size:23px&quot;&gt;知识与记忆域&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;RAG：混合检索 + 重排 + ACL&lt;br&gt;文档版本、引用、有效期&lt;br&gt;Memory：授权偏好与任务状态&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CEAA71;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="525" y="920" width="410" height="135" as="geometry"/></mxCell>
<mxCell id="transaction" value="&lt;b style=&quot;font-size:23px&quot;&gt;交易与专业服务域&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;购物车 / 报价 / 订单 / 售后&lt;br&gt;风控、幂等、查单、补偿&lt;br&gt;外部天气等经受控适配器&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CEAA71;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="990" y="920" width="390" height="135" as="geometry"/></mxCell>
<mxCell id="state" value="&lt;b style=&quot;font-size:23px&quot;&gt;在线状态与数据底座&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;会话 / 任务 / 实体快照：持久化数据库 + 缓存&lt;br&gt;执行账本、幂等记录、确认单、Outbox / 事件总线；缓存不是交易唯一真相&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#9BAFBF;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="1160" width="1300" height="110" as="geometry"/></mxCell>
<mxCell id="pipeline" value="&lt;b style=&quot;font-size:23px&quot;&gt;离线数据与 RAG 管道&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;授权数据 → 清洗 / 质检 / 审核 → Document 分块 → Embedding → 持久向量 + 关键词索引&lt;br&gt;商品 / 政策更新与撤回驱动增量索引；画像更新需同意、期限和删除传播&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CEAA71;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="1320" width="1300" height="115" as="geometry"/></mxCell>
<mxCell id="control" value="&lt;b style=&quot;font-size:23px&quot;&gt;控制平面｜研发协作&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;产品：场景、体验、业务验收&lt;br&gt;Agent：Runtime / Prompt / Skill&lt;br&gt;算法：模型、评测、策略&lt;br&gt;业务域：Tool 与事实契约&lt;br&gt;数据：知识、画像与血缘&lt;br&gt;安全：权限、隐私与风控&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#9BAFBF;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1470" y="155" width="340" height="280" as="geometry"/></mxCell>
<mxCell id="release" value="&lt;b style=&quot;font-size:23px&quot;&gt;版本与发布&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;统一 Release Manifest&lt;br&gt;Prompt / Skill / Tool / 模型&lt;br&gt;Policy / 索引 / 卡片 schema&lt;br&gt;离线评测 → 灰度 → 回滚&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#9BAFBF;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1470" y="505" width="340" height="235" as="geometry"/></mxCell>
<mxCell id="operate" value="&lt;b style=&quot;font-size:23px&quot;&gt;运行平面｜SRE + 值班&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;全链路 Trace / 指标 / 脱敏日志&lt;br&gt;SLO、容量、成本与依赖治理&lt;br&gt;按能力熔断、读写隔离&lt;br&gt;故障接管、查单与对账&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#9BAFBF;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1470" y="815" width="340" height="235" as="geometry"/></mxCell>
<mxCell id="security" value="&lt;b style=&quot;font-size:23px&quot;&gt;横切治理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;输入 / 检索 / 调用 / 输出检查&lt;br&gt;最小权限、数据分级&lt;br&gt;安全确认、人工复核&lt;br&gt;默认拒绝与可追溯审计&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FCEDEA;strokeColor=#D49991;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1470" y="1120" width="340" height="235" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b style=&quot;font-size:23px&quot;&gt;实线：在线调用 / 数据依赖；虚线：控制或离线发布。返回结果沿原调用路径回填，图中省略反向线。&lt;/b&gt;" style="text;fillOpacity=0;strokeOpacity=0;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#9BAFBF;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="1480" width="1730" height="55" as="geometry"/></mxCell>
<mxCell id="boundary" value="&lt;b style=&quot;font-size:23px&quot;&gt;建议先以模块化服务落地；图中能力域不等于每框必须拆一个微服务。交易写入不得由模型直接访问数据库。&lt;/b&gt;" style="text;fillOpacity=0;strokeOpacity=0;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#9BAFBF;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="1550" width="1730" height="55" as="geometry"/></mxCell>
