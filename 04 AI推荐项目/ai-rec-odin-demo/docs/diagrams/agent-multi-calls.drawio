<mxCell id="title" value="02A / 模块调用关系 · 根任务唯一 Owner，子任务与外部委派按需扩展" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=35;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="70" y="20" width="3090" height="70" as="geometry"/></mxCell>
<mxCell id="legend" value="蓝：在线调用（返回原路）　绿：App 直达 Domain　紫：委派 / 产物回填　红：跨边界调用　灰虚线：配置与治理｜不是每请求都走完全部分支" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="3090" height="65" as="geometry"/></mxCell>
<mxCell id="access" value="&lt;b style=&quot;font-size:27px&quot;&gt;用户 / 客户端 → 公共网关&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;认证、风控、可信身份与 scopes、requestId；按入口路由，不把用户身份交给模型伪造&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="190" width="3000" height="110" as="geometry"/></mxCell>
<mxCell id="search-app" value="&lt;b style=&quot;font-size:27px&quot;&gt;ai-search-app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;搜索 Workflow / 实验 / Reply&lt;br&gt;简单直达 Domain，复杂进入搜索池&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="385" width="660" height="130" as="geometry"/></mxCell>
<mxCell id="rec-app" value="&lt;b style=&quot;font-size:27px&quot;&gt;ai-rec-app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;推荐 Workflow / 实验 / Reply&lt;br&gt;简单直达 Domain，复杂进入推荐池&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="385" width="660" height="130" as="geometry"/></mxCell>
<mxCell id="search-root" value="&lt;b style=&quot;font-size:27px&quot;&gt;search-runtime｜根搜索任务池&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;rootRun Owner；主 Skill / Prompt / LLM Loop&lt;br&gt;控制子任务生命周期、总预算与最终交付&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="635" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="rec-root" value="&lt;b style=&quot;font-size:27px&quot;&gt;rec-runtime｜根推荐任务池&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;rootRun Owner；主 Skill / Prompt / LLM Loop&lt;br&gt;同一执行机制，独立版本、容量与发布&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="635" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="delegation" value="&lt;b style=&quot;font-size:27px&quot;&gt;Delegation Manager｜每个根 Runtime 内的逻辑模块&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;仅接受允许目录与可委派矩阵中的目标；创建 childRun / remoteTask 映射&lt;br&gt;分配子预算、并发 / 深度 / deadline；跟踪、查询、取消与回收&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="635" width="1310" height="150" as="geometry"/></mxCell>
<mxCell id="tool" value="&lt;b style=&quot;font-size:27px&quot;&gt;Tool Gateway / Adapter｜主任务与子任务使用同一治理机制&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;schema / 身份 / scope / deadline / 审计 / 结构化错误&lt;br&gt;两个运行池各自装配；不表示新建一个所有请求都必须经过的共享进程&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="980" width="1510" height="145" as="geometry"/></mxCell>
<mxCell id="child" value="&lt;b style=&quot;font-size:27px&quot;&gt;内部子 Agent Worker（可选）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;独立 childRun / Skill / Prompt / 局部循环&lt;br&gt;证据研究、品类选购、适配研究&lt;br&gt;子任务上下文只读投影，局部状态隔离&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="980" width="610" height="175" as="geometry"/></mxCell>
<mxCell id="agent-gateway" value="&lt;b style=&quot;font-size:27px&quot;&gt;Agent Gateway（可选）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Agent Registry / Card、鉴权、数据投影&lt;br&gt;A2A 或明确的 RPC / HTTPS task API&lt;br&gt;提交 / 查询 / 取消 / 重连 / 产物检查&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2510" y="980" width="590" height="175" as="geometry"/></mxCell>
<mxCell id="search-domain" value="&lt;b style=&quot;font-size:27px&quot;&gt;search-domain / Hints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;商品召回、过滤、相关性排序&lt;br&gt;输出 CandidateSet&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="1320" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="rec-domain" value="&lt;b style=&quot;font-size:27px&quot;&gt;rec-domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;推荐召回、排序、集合约束&lt;br&gt;输出 RecommendationSlate&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="635" y="1320" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="rag" value="&lt;b style=&quot;font-size:27px&quot;&gt;RAG / knowledge-domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;SKU / ACL / 有效期过滤与检索&lt;br&gt;返回 EvidenceBundle；详见 02B&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1170" y="1320" width="440" height="140" as="geometry"/></mxCell>
<mxCell id="child-context" value="&lt;b style=&quot;font-size:27px&quot;&gt;子任务运行支撑&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;局部 LLM 调用、Memory / 检查点命名空间&lt;br&gt;工具执行走左侧 Adapter，不得越权&lt;br&gt;外部产物经校验，不直接写入主状态&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="1320" width="610" height="150" as="geometry"/></mxCell>
<mxCell id="external-agent" value="&lt;b style=&quot;font-size:27px&quot;&gt;外部 Agent｜他部门 / 合作方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;独立 remoteTaskId / 状态 / 产物&lt;br&gt;自己的 LLM、Memory、Tool 与部署&lt;br&gt;旅行规划 / 专业适配研究（示例）&lt;br&gt;不直接访问我方用户凭证与交易&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF0F0;strokeColor=#C88178;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2510" y="1320" width="590" height="190" as="geometry"/></mxCell>
<mxCell id="facts" value="&lt;b style=&quot;font-size:27px&quot;&gt;商品 / 价格 / 库存 / 可售性基础服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Tool、Domain 与 App Reply 按需核价、填充实体卡&lt;br&gt;Agent 产物不能替代权威实时事实&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="1600" width="730" height="140" as="geometry"/></mxCell>
<mxCell id="users" value="&lt;b style=&quot;font-size:27px&quot;&gt;用户 / 行为 / 外部信息接入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;画像、授权特征、天气、景点与网页等&lt;br&gt;普通服务仍按 Tool 调用，不一律包装 Agent&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="1600" width="710" height="140" as="geometry"/></mxCell>
<mxCell id="merge" value="&lt;b style=&quot;font-size:27px&quot;&gt;主任务验收产物｜Delegation Manager → 根 Runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;状态、候选引用、证据与反证、来源版本、限制、用量 → 校验 / 去重 / 合并&lt;br&gt;可选任务超时可降级；必需证据失败收窄或拒绝结论；等待用户由 App 统一处理&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="1650" width="1310" height="150" as="geometry"/></mxCell>
<mxCell id="model" value="&lt;b style=&quot;font-size:27px&quot;&gt;模型基础服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;主 / 子 Runtime → LLM&lt;br&gt;RAG → Embedding / Reranker&lt;br&gt;根任务费用统一归集&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="1970" width="440" height="160" as="geometry"/></mxCell>
<mxCell id="memory" value="&lt;b style=&quot;font-size:27px&quot;&gt;Memory / 持久状态基础服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;root / child 命名空间隔离&lt;br&gt;委派账本、检查点、受控引用&lt;br&gt;长期偏好不由子任务自由覆盖&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="635" y="1970" width="440" height="160" as="geometry"/></mxCell>
<mxCell id="data" value="&lt;b style=&quot;font-size:27px&quot;&gt;索引 / 特征 / 证据存储&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;商品 / 知识检索、原文与版本&lt;br&gt;按 ACL 与账户隔离&lt;br&gt;知识后台摄取与索引发布&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1170" y="1970" width="440" height="160" as="geometry"/></mxCell>
<mxCell id="trade" value="&lt;b style=&quot;font-size:27px&quot;&gt;独立交易域&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;App 可信确认 → 报价复核 → 幂等执行 / 查单&lt;br&gt;主 / 子 / 外部 Agent 均不能自证授权&lt;br&gt;首期委派仅只读，取消不等于撤销订单&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF0F0;strokeColor=#C88178;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="1970" width="610" height="160" as="geometry"/></mxCell>
<mxCell id="control" value="&lt;b style=&quot;font-size:27px&quot;&gt;agentControl + 配置 / 制品平台&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Agent / Skill / Prompt / Model 目录与版本&lt;br&gt;Owner、SLA、委派矩阵、白名单与数据出口&lt;br&gt;评测 / 实验 / 预算 / 审计 / 灰度与回滚&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="385" width="1310" height="145" as="geometry"/></mxCell>
<mxCell id="ops" value="&lt;b style=&quot;font-size:27px&quot;&gt;横向安全与 SRE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;父子 Trace、配额、告警、证据与版本&lt;br&gt;取消确认、未知状态、迟到结果隔离&lt;br&gt;权限撤销及时失效；总预算不可复制&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2510" y="1970" width="590" height="160" as="geometry"/></mxCell>
<mxCell id="footer" value="&lt;b style=&quot;font-size:27px&quot;&gt;部署与循环规则&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;原 7 个核心部署单元是基线：可选 Worker / Agent Gateway 优先模块化或复用已有平台；外部 Agent 由对方维护。&lt;br&gt;禁止根 Runtime 池互相递归启动根请求；允许经审核的能力目录和委派契约创建受限 childRun / remoteTask。&lt;br&gt;主 / 子循环均计入根任务预算；并行 Tool 不等于多 Agent；A2A 是可选互操作协议，不是跨团队调用的强制替代品。&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="2320" width="3000" height="170" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
