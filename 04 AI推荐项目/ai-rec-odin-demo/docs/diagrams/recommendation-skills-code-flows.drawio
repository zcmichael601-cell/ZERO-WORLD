<mxfile host="app.diagrams.net" type="device"><diagram id="standard" name="普通版：模型自主规划的 Agent Loop"><mxGraphModel dx="1000" dy="950" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="普通版：模型自主规划的 Agent Loop" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=29;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="920" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="shopping-recommendation · AGENT · commerce handler" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="920" height="30" as="geometry"/></mxCell><mxCell id="legend-runtime" value="Runtime / 代码" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#FFF4DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="220" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="legend-model" value="LLM 模型" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#EAF1FF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="420" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="legend-tool" value="Tool / 数据" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#E8F5EE;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="620" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="request" value="校验输入 → AgentLoopExecutor&#xa;首次只开放 Skill 工具；不预先执行用户查询" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#FFF4DF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="640" height="72" as="geometry"/></mxCell><mxCell id="load" value="LLM 请求加载 Skill → Runtime 返回指令&#xa;根据真实事实和本轮可用工具自主规划" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#EAF1FF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="250" width="640" height="76" as="geometry"/></mxCell><mxCell id="decide" value="LLM 选择下一步：工具调用或最终答案&#xa;每轮提供事实状态；重复/截断有界恢复&#xa;可调整用户查询顺序、合并请求、补搜与补查" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#EAF1FF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="370" width="640" height="96" as="geometry"/></mxCell><mxCell id="tools" value="整体审查工具计划 → 执行受控工具&#xa;画像/行为、商品搜索、RAG；写回真实结果&#xa;检查依赖、重复和预算，保护最终回答机会" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#E8F5EE;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="510" width="640" height="120" as="geometry"/></mxCell><mxCell id="finish" value="finish()：校验最终推荐后发布&#xa;校验 SKU、预算和原文引用；答案纠正不重跑工具" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#FFF4DF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="750" width="640" height="84" as="geometry"/></mxCell><mxCell id="edge-0" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="request" target="load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-1" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="load" target="decide"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-2" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="decide" target="tools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-3" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="tools" target="decide"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="570"/><mxPoint x="900" y="418"/></Array></mxGeometry></mxCell><mxCell id="edge-4" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="decide" target="finish"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="52" y="418"/><mxPoint x="52" y="792"/></Array></mxGeometry></mxCell><mxCell id="footer" value="模型轮数不固定；画像/行为各至多一次，搜索/知识各至多两次。&#xa;总上限仍为 8 / 8；拒绝相同参数的重复请求，允许有依据的补查。" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="881" width="940" height="64" as="geometry"/></mxCell><mxCell id="label-2" value="需要工具" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="506" y="474" width="92" height="30" as="geometry"/></mxCell><mxCell id="label-3" value="工具结果&#xa;或重新规划&#xa;继续下一轮" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="852" y="450" width="136" height="81" as="geometry"/></mxCell><mxCell id="label-4" value="事实已足够&#xa;且必需工具&#xa;均已完成" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="5" y="561" width="136" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="fast" name="极速版：程序召回，模型筛选与有界修正"><mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="极速版：程序召回，模型筛选与有界修正" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=29;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="920" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="shopping-recommendation-fast · PREPARED_RECOMMENDATION" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="920" height="30" as="geometry"/></mxCell><mxCell id="legend-runtime" value="Runtime / 代码" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#FFF4DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="220" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="legend-model" value="LLM 模型" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#EAF1FF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="420" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="legend-tool" value="Tool / 数据" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#E8F5EE;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="620" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="request" value="RecommendationWorkflows → WorkflowExecutor&#xa;Runtime 主动加载 Skill；不请模型决定是否取数" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#FFF4DF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="640" height="72" as="geometry"/></mxCell><mxCell id="users" value="顺序执行 get_user_profile → get_user_behaviors&#xa;真实 UUID 查 AI Memory；演示用户读取固定画像与行为" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#E8F5EE;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="248" width="640" height="76" as="geometry"/></mxCell><mxCell id="search" value="代码准备参数 → search_products&#xa;ProductSearchService 匹配目录标签；召回最多 6 件&#xa;过滤价格未知、过期、明确缺货和超预算商品" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#E8F5EE;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="360" width="640" height="88" as="geometry"/></mxCell><mxCell id="context" value="prepareFastAnswer()：压缩事实，构建 Prompt&#xa;用户资料 + 候选与标签 + outputSchema" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#FFF4DF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="484" width="640" height="72" as="geometry"/></mxCell><mxCell id="generate" value="LLM 相对优选并生成简短推荐&#xa;有候选选 1~2 件；无候选才可为空；不做 RAG" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#EAF1FF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="592" width="640" height="80" as="geometry"/></mxCell><mxCell id="finish" value="校验 SKU、数量、分值和预算 → 回填商品卡&#xa;无效则复用事实让模型修正一次；不重跑工具&#xa;仍无效明确失败；不按目录顺序代选商品" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#FFF4DF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="712" width="640" height="94" as="geometry"/></mxCell><mxCell id="edge-0" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="request" target="users"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-1" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="users" target="search"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-2" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="search" target="context"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-3" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="context" target="generate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-4" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="generate" target="finish"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="footer" value="模型正常 1 轮，最多 2 轮；工具固定 4 次，含 Skill 加载；用户工具顺序执行。&#xa;目标约 5 秒不是 SLA；跳过的是请求内 RAG，不是全服务的启动索引预加载。" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="831" width="940" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="deep" name="满血版：三轮决策，扩大召回与证据"><mxGraphModel dx="1000" dy="1130" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1130"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="满血版：三轮决策，扩大召回与证据" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=29;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="920" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="shopping-recommendation-deep · DEEP_RECOMMENDATION_WORKFLOW" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="920" height="30" as="geometry"/></mxCell><mxCell id="legend-runtime" value="Runtime / 代码" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#FFF4DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="220" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="legend-model" value="LLM 模型" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#EAF1FF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="420" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="legend-tool" value="Tool / 数据" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;rounded=1;fillColor=#E8F5EE;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="620" y="94" width="170" height="28" as="geometry"/></mxCell><mxCell id="prepare" value="RecommendationWorkflows → WorkflowExecutor&#xa;Runtime 加载 Skill → 画像 → 行为；不消耗模型轮次" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#FFF4DF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="640" height="82" as="geometry"/></mxCell><mxCell id="plan" value="LLM 第 1 轮：决定需求词与召回参数&#xa;受限 JSON 决策；Runtime 校验后转成工具调用" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#EAF1FF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="262" width="640" height="78" as="geometry"/></mxCell><mxCell id="search" value="search_products → DeepProductSearchTool&#xa;目录词汇匹配 + 多需求语义召回 → 融合、去重&#xa;基于有效快照/预算筛选，候选最多 48 件" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#E8F5EE;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="380" width="640" height="104" as="geometry"/></mxCell><mxCell id="select" value="LLM 第 2 轮：选择最多 8 件商品深读&#xa;受限 JSON 决策，只能选本次已召回的 SKU" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#EAF1FF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="524" width="640" height="78" as="geometry"/></mxCell><mxCell id="knowledge" value="retrieve_product_knowledge → 深读实现&#xa;展开所选 SKU 在同版索引中的全部原文片段&#xa;不是再次用一个 question 做少量片段召回" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#E8F5EE;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="642" width="640" height="88" as="geometry"/></mxCell><mxCell id="generate" value="LLM 第 3 轮：生成推荐与多维对比&#xa;最多 6 件；选择 evidenceId + quoteId，不重抄原文" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#EAF1FF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="770" width="640" height="84" as="geometry"/></mxCell><mxCell id="finish" value="回填原文 → finish() 校验 → 发布&#xa;检查格式、SKU、预算、数量和引用；不合格不发布&#xa;允许有界修正最终 JSON，保留已完成的工具结果" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;rounded=1;arcSize=15;fillColor=#FFF4DF;strokeColor=#C2D0DC;fontSize=17;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="904" width="640" height="88" as="geometry"/></mxCell><mxCell id="edge-0" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prepare" target="plan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-1" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="plan" target="search"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-2" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="search" target="select"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-3" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="select" target="knowledge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-4" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="knowledge" target="generate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-5" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="generate" target="finish"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-6" style="html=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B7488;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="finish" target="generate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="948"/><mxPoint x="900" y="812"/></Array></mxGeometry></mxCell><mxCell id="footer" value="正常路径约 3 轮模型、5 次工具（含 Skill）。模型/工具配置上限为 12 / 20，不是目标次数。&#xa;耗时主要取决于向量召回、模型推理和长答案生成；完整证据不等于独立测评。" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="1061" width="940" height="64" as="geometry"/></mxCell><mxCell id="label-6" value="校验需修正&#xa;且预算允许&#xa;不重复检索" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontColor=#253C4B;fontSize=14;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="852" y="836" width="136" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
