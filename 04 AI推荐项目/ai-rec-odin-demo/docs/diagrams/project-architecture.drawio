<mxCell id="ui-group-title" value="交互层  ·  ai-rec-odin-demo-main / static" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=23;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="161" width="2184" height="36" as="geometry"/></mxCell>
<mxCell id="ui-chat" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;AI 对话  ·  index.html&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;消息 + chatId；接收 delta / done / error&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="600" height="78" as="geometry"/></mxCell>
<mxCell id="ui-skill" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;Skill 实验室  ·  skills.html&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;选择技能与用户；过程提示 + 内容流 + 结果卡片&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="855" y="210" width="610" height="78" as="geometry"/></mxCell>
<mxCell id="ui-rag" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;知识库问答  ·  rag.html&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;构建索引 / 提问；原文依据 + 流式回答 + 引用&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1630" y="210" width="600" height="78" as="geometry"/></mxCell>
