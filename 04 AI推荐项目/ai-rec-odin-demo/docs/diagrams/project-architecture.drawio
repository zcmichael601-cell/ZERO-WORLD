<mxCell id="api-group-title" value="接口层  ·  ai-rec-odin-demo-web" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=23;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="371" width="2184" height="36" as="geometry"/></mxCell>
<mxCell id="api-chat" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;ChatController&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;POST /chat/stream；普通对话及扩展示例入口&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="415" width="600" height="72" as="geometry"/></mxCell>
<mxCell id="api-skill" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;SkillController&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;/api/skills/{id}/stream；另保留同步 /run&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="855" y="415" width="610" height="72" as="geometry"/></mxCell>
<mxCell id="api-rag" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;RagController&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;/api/rag/index · /search · /ask · /stream&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1630" y="415" width="600" height="72" as="geometry"/></mxCell>
<mxCell id="chat-group" value="" style="rounded=1;arcSize=3;fillColor=#FAFCFE;strokeColor=#DFE7EF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="690" height="790" as="geometry"/></mxCell>
<mxCell id="chat-group-title" value="普通对话与既有扩展" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=23;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="581" width="634" height="36" as="geometry"/></mxCell>
<mxCell id="skill-group" value="" style="rounded=1;arcSize=3;fillColor=#FAFCFE;strokeColor=#DFE7EF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="815" y="565" width="690" height="790" as="geometry"/></mxCell>
<mxCell id="skill-group-title" value="SkillEngine  ·  模型驱动的工具循环" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=23;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="843" y="581" width="634" height="36" as="geometry"/></mxCell>
<mxCell id="rag-group" value="" style="rounded=1;arcSize=3;fillColor=#FAFCFE;strokeColor=#DFE7EF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1590" y="565" width="690" height="790" as="geometry"/></mxCell>
<mxCell id="rag-group-title" value="RagService  ·  独立检索增强问答" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=23;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1618" y="581" width="634" height="36" as="geometry"/></mxCell>
<mxCell id="chat-agent" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;ChatClientAgent  +  ChatClient&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;调用默认 Prompt，追加用户消息&lt;br&gt;MessageChatMemoryAdvisor 按 chatId 维护会话&lt;br&gt;使用已有 JoyAI / Spring AI 自动配置模型&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#ADBCCA;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="645" width="610" height="140" as="geometry"/></mxCell>
<mxCell id="chat-prompt" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;PROMPT  ·  普通对话上下文&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;PromptService / 可配置模板&lt;br&gt;默认提示 + UserMessage + 会话记忆&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#729ED9;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="850" width="610" height="110" as="geometry"/></mxCell>
<mxCell id="chat-extensions" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;既有接口扩展  ·  不等于默认对话流程&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;/chat/tools → 本地 @Tool&lt;br&gt;/chat/mcp → ToolCallbackProvider&lt;br&gt;/chat/vector → RetrievalAugmentationAdvisor → Vearch&lt;br&gt;/agent/* → ReAct / 串行 / 并行 / 路由示例&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#ADBCCA;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="1050" width="610" height="220" as="geometry"/></mxCell>
<mxCell id="skill-engine" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;SkillEngine  ·  单次运行隔离&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;先仅暴露 Skill 加载器，再开放配置中的业务工具&lt;br&gt;校验允许工具、调用 ID、轮次及调用预算&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ECF7F2;strokeColor=#70B39A;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="855" y="645" width="610" height="110" as="geometry"/></mxCell>
<mxCell id="skill-prompt" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;PROMPT  ·  本轮模型上下文&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;SystemMessage 约束 + UserMessage 输入&lt;br&gt;Assistant tool_calls + ToolResponseMessage 历史&lt;br&gt;已加载的 SKILL.md 指令包含在工具返回中&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#729ED9;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="855" y="810" width="610" height="130" as="geometry"/></mxCell>
<mxCell id="tools" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;TOOL  ·  ToolCallingManager / ToolCallback&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;模型决定工具名与参数，Java 回调真正执行&lt;br&gt;画像 / 行为 / 商品 → 本地业务数据&lt;br&gt;天气 → Open-Meteo；热门景点 → 携程公开榜单&lt;br&gt;结果回填 ToolResponseMessage，交给下一轮模型&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#E7F7F4;strokeColor=#55A999;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="855" y="1020" width="610" height="190" as="geometry"/></mxCell>
<mxCell id="skill-config" value="&lt;div style=&quot;font-size:19px;line-height:1.2;font-weight:600;&quot;&gt;SKILL  ·  本地配置 + 按需加载&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.35;margin-top:8px;&quot;&gt;skills/recommendation.json：启停、白名单、预算&lt;br&gt;相邻 SKILL.md：任务步骤、输出要求、业务约束&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF8EB;strokeColor=#CCAD78;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="855" y="1250" width="610" height="85" as="geometry"/></mxCell>
<mxCell id="rag-kb" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;RagKnowledgeBase  ·  索引与检索&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;Document → TokenTextSplitter → 向量化 → 内存索引&lt;br&gt;SimpleVectorStore + VectorStoreDocumentRetriever&lt;br&gt;默认 Top-K = 4、阈值 = 0.5；每次问答读取一个快照&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF5E3;strokeColor=#D4A657;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1630" y="645" width="600" height="140" as="geometry"/></mxCell>
<mxCell id="rag-prompt" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;PROMPT  ·  检索增强上下文&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px;&quot;&gt;SystemMessage：仅基于资料、忽略资料中的指令&lt;br&gt;UserMessage：question + 命中原文 sources（C1…）&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#729ED9;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1630" y="850" width="600" height="110" as="geometry"/></mxCell>
<mxCell id="rag-validation" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;结果与引用校验&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;完整模型响应 → JSON 解析 → 引用 ID 与正文标记校验&lt;br&gt;无命中不请求对话模型；模型也可判断资料不足&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF5E3;strokeColor=#D4A657;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1630" y="1030" width="600" height="110" as="geometry"/></mxCell>
<mxCell id="knowledge-files" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;本地知识资料  ·  knowledge/*.md&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;商品手册与服务说明；支持配置外部本地目录&lt;br&gt;独立内存索引，不写入既有 Vearch；重启后需重建&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF8EB;strokeColor=#CCAD78;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1630" y="1225" width="600" height="110" as="geometry"/></mxCell>
<mxCell id="foundation" value="" style="rounded=1;arcSize=3;fillColor=#FAFCFE;strokeColor=#DFE7EF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="2240" height="235" as="geometry"/></mxCell>
<mxCell id="foundation-title" value="Spring AI 1.1 底座与现有模型服务" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=23;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="1416" width="2184" height="36" as="geometry"/></mxCell>
<mxCell id="model-config" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;现有服务端模型配置&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;profile/ai.properties：模型名 / 地址 / 路径 / Key&lt;br&gt;SkillModelConfiguration + RagConfiguration&lt;br&gt;复用配置，密钥不下发浏览器&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#ADBCCA;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="1470" width="600" height="125" as="geometry"/></mxCell>
<mxCell id="llm" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;LLM  ·  现有 GLM 对话模型&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;Skill / 新 RAG：OpenAiChatModel → ChatModel.stream()&lt;br&gt;普通对话：ChatClient → 已配置 ChatModel&lt;br&gt;接收 Prompt；返回正文或原生 tool_calls&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F0EBFC;strokeColor=#A68ACE;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="855" y="1470" width="610" height="125" as="geometry"/></mxCell>
<mxCell id="embedding" value="&lt;div style=&quot;font-size:21px;line-height:1.2;font-weight:600;&quot;&gt;EMBEDDING  ·  现有 bge-m3&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;OpenAiEmbeddingModel → 真实向量接口&lt;br&gt;对文档片段及用户问题向量化&lt;br&gt;用于检索，不负责生成自然语言答案&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F0EBFC;strokeColor=#A68ACE;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1630" y="1470" width="600" height="125" as="geometry"/></mxCell>
<mxCell id="boundaries" value="&lt;div style=&quot;font-size:19px;line-height:1.2;font-weight:600;&quot;&gt;关键边界&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;LLM 只提出工具调用，真正的动作由服务端 Tool 执行。新 RAG 是固定的“先检索再回答”，目前不是 Skill 自动调用的工具。&lt;br&gt;流式展示的是公开正文，不是内部思维链；引用标识通过校验不等于每句事实都正确，仍应对照原文。&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF1E8;strokeColor=#D89A75;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1670" width="2200" height="90" as="geometry"/></mxCell>
<mxCell id="startup" value="启动范围：完整 AiRecOdinDemoApplication 包含既有 /chat、/agent 与 Vearch 相关能力；轻量 SkillDemoApplication 仅装配 Skill + 新 RAG（不含 ChatController）。&lt;br&gt;图例：实线＝调用 / 数据依赖；双向箭头＝模型请求与返回；虚线＝配置或本地资料输入。本图聚焦 AI 核心，不展开订单与基础中间件。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=16;fontColor=#52667D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="1790" width="2190" height="75" as="geometry"/></mxCell>
