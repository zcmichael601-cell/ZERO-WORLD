<mxCell id="title" value="案例五｜外部服务协作：先取得方案，再可信确认与执行" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=34;fontColor=#243A4A;" vertex="1" parent="1"><mxGeometry x="60" y="15" width="2820" height="62" as="geometry"/></mxCell>
<mxCell id="subtitle" value="选购家电后咨询周六安装 / 家政预约 · 外部 Agent 只在独立多步任务确有价值时启用" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=22;fontColor=#586B79;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="2800" height="45" as="geometry"/></mxCell>
<mxCell id="control" value="横向百策：开发者注册 / 评测 / 发布 → Runtime 加载 Prompt、Skill、LLM 配置与 Tool 权限快照&lt;br&gt;L1 / L2 / L3 传播实验与 Trace；百策不是逐轮模型调用入口，模型推理由 MaaS 提供" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=21;fontColor=#243A4A;" vertex="1" parent="1"><mxGeometry x="85" y="149" width="2770" height="66" as="geometry"/></mxCell>
<mxCell id="lane-title-0" value="&lt;b&gt;L1 · 交互模块 / 用户&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;搜 / 推所属应用&lt;br&gt;可信确认页与操作状态&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8EDDE;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="82" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-1" value="&lt;b&gt;L1 · 业务 Workflow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;service-assist&lt;br&gt;业务状态 / 确认 / 交易分支&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8EDDE;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="482" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-2" value="&lt;b&gt;L2 · 所属 Runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Prompt / Skill / Loop&lt;br&gt;可选内部子 Agent&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9F2FE;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="882" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-3" value="&lt;b&gt;L2 · Agent Adaptor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;身份 / 协议 / remoteTaskId&lt;br&gt;超时 / 取消 / 产物归一&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9F2FE;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="1282" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-4" value="&lt;b&gt;L3 · 业务与交易服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;资格 / 报价 / 预约 / 订单&lt;br&gt;订单状态的权威来源&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EAF5ED;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="1682" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-5" value="&lt;b&gt;L4 · AI 公共服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Context / Memory / RAG / MaaS&lt;br&gt;内部任务共用受控底座&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F1EBFA;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="2082" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-6" value="&lt;b&gt;外部 · 专业 Agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;家政 / 安装 / 下单等&lt;br&gt;独立平台与 SLA&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FBEAF2;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="2482" y="249" width="376" height="98" as="geometry"/></mxCell>
