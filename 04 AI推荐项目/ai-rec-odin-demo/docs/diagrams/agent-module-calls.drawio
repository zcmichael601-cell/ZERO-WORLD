<mxCell id="title" value="02A / AI 搜索 × AI 推荐 · 完整模块调用关系（目标设计）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=34;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="2580" height="65" as="geometry"/></mxCell>
<mxCell id="legend" value="箭头：调用方 → 被调用方（响应原路返回）　蓝线：在线调用　绿粗线：App 直达 Domain　灰虚线：配置发布　红线：可信交易" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="2600" height="55" as="geometry"/></mxCell>
<mxCell id="client" value="&lt;b style=&quot;font-size:25px&quot;&gt;消费者客户端｜搜索框 / 推荐流 / 对话 / 可信确认页&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;展示流式内容、证据与商品卡；提交明确反馈；不直连内部服务&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="175" width="1630" height="105" as="geometry"/></mxCell>
<mxCell id="access" value="&lt;b style=&quot;font-size:25px&quot;&gt;公共接入 Gateway｜认证 / 风控 / 限流 / 路由&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;服务端注入 userId、scopes、requestId；搜索与推荐流量独立配额&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="1630" height="100" as="geometry"/></mxCell>
<mxCell id="search-app" value="&lt;b style=&quot;font-size:25px&quot;&gt;ai-search-app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;业务 Workflow / 分流 / 实验 / Reply&lt;br&gt;普通检索直达 Domain；复杂任务进入 Runtime&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="505" width="680" height="130" as="geometry"/></mxCell>
<mxCell id="rec-app" value="&lt;b style=&quot;font-size:25px&quot;&gt;ai-rec-app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;业务 Workflow / 分流 / 反馈 / Reply&lt;br&gt;普通刷新直达 Domain；深度选购进入 Runtime&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="505" width="680" height="130" as="geometry"/></mxCell>
<mxCell id="search-runtime" value="&lt;b style=&quot;font-size:25px&quot;&gt;search-runtime｜搜索运行池&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;同一共建内核；独立版本、容量与发布&lt;br&gt;Agent Loop / Context / Prompt / Skill&lt;br&gt;Tool 执行、预算、检查点、真实进度&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="730" width="680" height="165" as="geometry"/></mxCell>
<mxCell id="rec-runtime" value="&lt;b style=&quot;font-size:25px&quot;&gt;rec-runtime｜推荐运行池&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;同一共建内核；独立版本、容量与发布&lt;br&gt;Agent Loop / Context / Prompt / Skill&lt;br&gt;Tool 执行、预算、检查点、真实进度&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="730" width="680" height="165" as="geometry"/></mxCell>
<mxCell id="tool" value="&lt;b style=&quot;font-size:25px&quot;&gt;Tool Gateway / Adapter｜两个 Runtime 各自装配同一机制，不表示新增共享网关实例&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;工具目录与 schema / 身份与权限 / deadline / 调用幂等与审计&lt;br&gt;内部 RPC 为主；按需适配 MCP；模型提出调用，服务端真正执行&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="1000" width="1630" height="125" as="geometry"/></mxCell>
<mxCell id="search-domain" value="&lt;b style=&quot;font-size:25px&quot;&gt;search-domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Query 编译 / 商品多路召回&lt;br&gt;过滤 / 相关性排序 / Hints&lt;br&gt;返回 CandidateSet&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1260" width="455" height="145" as="geometry"/></mxCell>
<mxCell id="rec-domain" value="&lt;b style=&quot;font-size:25px&quot;&gt;rec-domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;推荐召回 / 排序 / 集合重排&lt;br&gt;用户效用、约束与多样性&lt;br&gt;返回 RecommendationSlate&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="595" y="1260" width="455" height="145" as="geometry"/></mxCell>
<mxCell id="rag" value="&lt;b style=&quot;font-size:25px&quot;&gt;RAG / knowledge-domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;说明 / 政策 / 评价 / 问答&lt;br&gt;检索、重排、ACL、时效与引用&lt;br&gt;返回 EvidenceBundle，详见图 02B&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="1260" width="455" height="145" as="geometry"/></mxCell>
<mxCell id="facts" value="&lt;b style=&quot;font-size:25px&quot;&gt;权威业务基础服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;商品 / 价格 / 库存 / 可售性&lt;br&gt;用户画像 / 行为 / 授权&lt;br&gt;返回实体快照与授权特征&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1625" y="1260" width="455" height="145" as="geometry"/></mxCell>
<mxCell id="external" value="&lt;b style=&quot;font-size:25px&quot;&gt;外部信息接入服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;天气 / 地点 / 热榜 / 网页&lt;br&gt;出口白名单、缓存与来源时间&lt;br&gt;不得把用户画像发给任意站点&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2140" y="1260" width="455" height="145" as="geometry"/></mxCell>
<mxCell id="model" value="&lt;b style=&quot;font-size:25px&quot;&gt;模型基础服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;统一模型接入 / 路由 / 配额 / 熔断&lt;br&gt;LLM · Embedding · Reranker&lt;br&gt;召回 / 排序推理（可独立专用端点）&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1580" width="555" height="160" as="geometry"/></mxCell>
<mxCell id="memory" value="&lt;b style=&quot;font-size:25px&quot;&gt;Memory / 状态基础服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;会话与约束 / 候选引用 / 检查点&lt;br&gt;经授权的长期偏好、TTL 与删除&lt;br&gt;App 读会话；Runtime 管理任务状态&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="735" y="1580" width="555" height="160" as="geometry"/></mxCell>
<mxCell id="data" value="&lt;b style=&quot;font-size:25px&quot;&gt;共享数据与检索基础设施&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;倒排 / 向量检索 · Feature Store&lt;br&gt;证据原文 / 实体与候选存储&lt;br&gt;领域服务使用 SDK / RPC 受控访问&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1390" y="1580" width="555" height="160" as="geometry"/></mxCell>
<mxCell id="trade" value="&lt;b style=&quot;font-size:25px&quot;&gt;独立交易域 / 交易状态机&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;报价 → 可信确认 → 幂等执行&lt;br&gt;订单 / 查单对账 / 支付系统&lt;br&gt;Agent 只能提出意图，不能替用户授权&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FCEFEB;strokeColor=#C88178;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2045" y="1580" width="555" height="160" as="geometry"/></mxCell>
<mxCell id="control" value="&lt;b style=&quot;font-size:25px&quot;&gt;agent-control｜控制面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Prompt / Skill / Tool / Model&lt;br&gt;ACL / 预算 / 版本 / 实验&lt;br&gt;审批、发布、回滚&lt;br&gt;制品与配置快照异步分发&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2210" y="505" width="410" height="185" as="geometry"/></mxCell>
<mxCell id="ops" value="&lt;b style=&quot;font-size:25px&quot;&gt;横向治理与运行支撑&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;IAM / 密钥 / 服务发现&lt;br&gt;Trace / 指标 / 审计 / 告警&lt;br&gt;各调用点埋点与配额隔离&lt;br&gt;异步反馈 / 评测 / 发布门禁&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2210" y="760" width="410" height="200" as="geometry"/></mxCell>
<mxCell id="scope" value="基础依赖说明：蓝色 M / S 边连接 Runtime 与模型、Memory；App → Memory、领域 → 模型及 RAG 内部依赖在图 02B 展开。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="80" y="1810" width="2520" height="55" as="geometry"/></mxCell>
<mxCell id="rules" value="&lt;b style=&quot;font-size:25px&quot;&gt;边界与部署口径&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;一个 run 只有一个主循环，两个 Runtime 池不互调；搜索与推荐 Domain 不双向嵌套编排。&lt;br&gt;App 的确定性 Workflow 可直接组合 Domain；Agent 模式经 Tool Adapter 调用同一 Domain，均执行身份、配额与业务校验。&lt;br&gt;RAG、Memory、模型是显式逻辑能力，不等于必须新增独立微服务；原“7 个部署单元”只统计核心应用，不含复用基础平台。&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1910" width="2520" height="155" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
