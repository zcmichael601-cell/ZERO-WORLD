<mxCell id="title" value="案例四｜跨轮商品比较：Context 定对象，RAG 提依据" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=34;fontColor=#243A4A;" vertex="1" parent="1"><mxGeometry x="60" y="15" width="2420" height="62" as="geometry"/></mxCell>
<mxCell id="subtitle" value="这几款冲锋衣，哪款更适合雨天徒步？ · 默认只比较既有候选，不重新搜索全部商品" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=22;fontColor=#586B79;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="2400" height="45" as="geometry"/></mxCell>
<mxCell id="control" value="横向百策：开发者注册 / 评测 / 发布 → Runtime 加载 Prompt、Skill、LLM 配置与 Tool 权限快照&lt;br&gt;L1 / L2 / L3 传播实验与 Trace；百策不是逐轮模型调用入口，模型推理由 MaaS 提供" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=21;fontColor=#243A4A;" vertex="1" parent="1"><mxGeometry x="85" y="149" width="2370" height="66" as="geometry"/></mxCell>
<mxCell id="lane-title-0" value="&lt;b&gt;L1 · 交互模块&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;AI 推应用&lt;br&gt;用户 / 商卡 / 文本 / 流式协议&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8EDDE;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="82" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-1" value="&lt;b&gt;L1 · 业务执行模块&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Workflow&lt;br&gt;本地逻辑 / 领域 RPC / Agent RPC&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8EDDE;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="482" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-2" value="&lt;b&gt;L2 · rec-runtime&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Prompt / Skill / LLM Loop&lt;br&gt;状态 / 预算 / 校验&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9F2FE;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="882" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-3" value="&lt;b&gt;L2 · Tool Adaptor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;工具参数 / 权限校验&lt;br&gt;RPC / HTTP 适配&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9F2FE;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="1282" y="249" width="376" height="98" as="geometry"/></mxCell>
<mxCell id="lane-title-4" value="&lt;b&gt;L3 · 领域服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;搜索 / 推荐 / 商品&lt;br&gt;价格 / 库存 / 用户&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EAF5ED;strokeColor=#A9B8C4;fontFamily=PingFang SC;fontSize=22;fontColor=#243A4A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="1682" y="249" width="376" height="98" as="geometry"/></mxCell>
