<mxCell id="edge-22" value="真实执行事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#53769A;strokeWidth=2;fontFamily=PingFang SC;fontSize=20;fontColor=#53769A;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.25;entryX=1;entryY=0.8;" edge="1" parent="1" source="observe" target="progress"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-23" value="有限修正 / 必要补查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#17845C;strokeWidth=3;fontFamily=PingFang SC;fontSize=20;fontColor=#17845C;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.25;entryX=0;entryY=0.75;" edge="1" parent="1" source="validate" target="llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="2210"/><mxPoint x="705" y="1135"/><mxPoint x="820" y="1135"/><mxPoint x="820" y="1050"/></Array></mxGeometry></mxCell>
<mxCell id="edge-24" value="失败且无法再修正" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#BF726A;strokeWidth=2;fontFamily=PingFang SC;fontSize=20;fontColor=#BF726A;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="validate" target="fallback"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-25" value="校验通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#53769A;strokeWidth=2;fontFamily=PingFang SC;fontSize=20;fontColor=#53769A;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="validate" target="reply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-26" value="安全降级结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#BF726A;strokeWidth=2;fontFamily=PingFang SC;fontSize=20;fontColor=#BF726A;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="fallback" target="reply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="2523"/></Array></mxGeometry></mxCell>
<mxCell id="edge-27" value="最终卡片回源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#53769A;strokeWidth=2;fontFamily=PingFang SC;fontSize=20;fontColor=#53769A;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="reply" target="facts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1635" y="2523"/><mxPoint x="1635" y="2370"/><mxPoint x="2110" y="2370"/></Array></mxGeometry></mxCell>
<mxCell id="edge-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#53769A;strokeWidth=2;fontFamily=PingFang SC;fontSize=20;fontColor=#53769A;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reply" target="persist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-29" value="会话续存 / 下轮读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#17845C;strokeWidth=3;fontFamily=PingFang SC;fontSize=20;fontColor=#17845C;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.45;entryX=0;entryY=0.65;" edge="1" parent="1" source="persist" target="memory"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="2792"/><mxPoint x="50" y="946"/></Array></mxGeometry></mxCell>
<mxCell id="edge-30" value="授权事件 / 评测样本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8B98A9;strokeWidth=2;fontFamily=PingFang SC;fontSize=20;fontColor=#8B98A9;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="persist" target="evaluation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-31" value="评测 → 审核 → 下一版" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8B98A9;strokeWidth=2;fontFamily=PingFang SC;fontSize=20;fontColor=#8B98A9;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="evaluation" target="control"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2570" y="2800"/><mxPoint x="2570" y="253"/></Array></mxGeometry></mxCell>
<mxCell id="title" value="03 / 找到“对我更划算”的商品 · Agent 业务流程与模块协作" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=35;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="70" y="20" width="2470" height="70" as="geometry"/></mxCell>
<mxCell id="subtitle" value="目标设计示例：500 元内无线耳机 / 地铁通勤 / 安卓 / 重视降噪与舒适｜满足硬条件后比较收益、价格与限制，不等于最低价" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="2470" height="65" as="geometry"/></mxCell>
<mxCell id="control" value="&lt;b style=&quot;font-size:26px&quot;&gt;⓪ 上线前｜agentControl 发布版本化场景包&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;业务团队提交 Skill / Prompt / Tool 契约 → 评测与审核 → 模型路由、白名单、预算与灰度版本 → 各 Runtime 池本地快照&lt;br&gt;控制面不参与逐请求主循环；知识管道提前完成摄取、Embedding、索引与发布&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="2400" height="125" as="geometry"/></mxCell>
<mxCell id="app" value="&lt;b style=&quot;font-size:26px&quot;&gt;① 用户 → 网关 → App 分流&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;“想找性价比高的耳机，500 元内，地铁通勤”&lt;br&gt;身份校验 / requestId；复杂比较交给一个 Runtime 池&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="390" width="740" height="140" as="geometry"/></mxCell>
<mxCell id="context" value="&lt;b style=&quot;font-size:26px&quot;&gt;② Runtime 初始化任务与上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;加载选购 Skill；读取授权 Memory&lt;br&gt;当前输入优先；维护预算、用途、排除项与候选引用&lt;br&gt;组装 Prompt + Tool schema，创建 run / 版本快照&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="620" width="740" height="170" as="geometry"/></mxCell>
<mxCell id="skill" value="&lt;b style=&quot;font-size:26px&quot;&gt;Skill｜高性价比选购 SOP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;澄清 → 搜索 → 核价 / 查证 → 比较 → 解释取舍&lt;br&gt;声明允许工具、必需输出与证据不足处理&lt;br&gt;是指令与契约，不直接操作业务系统&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="555" width="600" height="170" as="geometry"/></mxCell>
<mxCell id="memory" value="&lt;b style=&quot;font-size:26px&quot;&gt;Memory / 状态基础服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;会话约束、授权偏好、已看 / 排除商品&lt;br&gt;candidateSetId、证据引用与持久检查点&lt;br&gt;本轮预算覆盖旧预算；长期偏好需授权&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="835" width="600" height="170" as="geometry"/></mxCell>
<mxCell id="llm" value="&lt;b style=&quot;font-size:26px&quot;&gt;③ Runtime 请求 LLM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;输入：Prompt + 当前目标 + 必要记忆 + 工具结果&lt;br&gt;模型提议：追问 / tool_calls / 有依据的比较&lt;br&gt;模型提议不等于工具已执行，也不是事实证明&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="930" width="740" height="160" as="geometry"/></mxCell>
<mxCell id="models" value="&lt;b style=&quot;font-size:26px&quot;&gt;模型基础服务 ≠ LLM 本身&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Runtime → 模型接入 / 路由 / 配额 → LLM&lt;br&gt;RAG → Embedding（如 bge-m3） / 可选 Reranker&lt;br&gt;LLM 做选择与解释；向量模型做编码&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="915" width="720" height="175" as="geometry"/></mxCell>
<mxCell id="route" value="&lt;b style=&quot;font-size:26px&quot;&gt;④ Runtime 判断模型动作&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;追问 → 等待用户；tool_calls → 受控执行&lt;br&gt;回答 → 结果校验；超时 / 超预算 → 收敛或降级&lt;br&gt;一个 run 只有一个主循环&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="1210" width="740" height="150" as="geometry"/></mxCell>
<mxCell id="clarify" value="&lt;b style=&quot;font-size:26px&quot;&gt;需要澄清｜App 等待用户&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;缺品类 / 预算 / 用途时再问，不猜购物目标&lt;br&gt;用户补充后恢复上下文；等待不消耗模型空转&lt;br&gt;Memory 不能替用户确认预算与意图&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1210" width="600" height="150" as="geometry"/></mxCell>
<mxCell id="tools" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑤ Tool Gateway / Adapter 真正调用&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;校验工具名、schema、身份、scope 与 deadline&lt;br&gt;候选相关调用必须先拿到有效 SKU&lt;br&gt;⑤a～⑤d 按需求选择、组合；不是固定顺序&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="1470" width="740" height="160" as="geometry"/></mxCell>
<mxCell id="search" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑤a searchProducts → search-domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;商品召回 / 属性过滤 / 预算预筛&lt;br&gt;输出真实 CandidateSet；不是模型生成商品名&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="1190" width="720" height="145" as="geometry"/></mxCell>
<mxCell id="rec" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑤b recommendProducts → rec-domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;按本轮目标、授权特征与已核验事实重排&lt;br&gt;输出 Slate 与理由特征；不盲信 LLM 自评分&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="1450" width="720" height="145" as="geometry"/></mxCell>
<mxCell id="rag" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑤c retrieveKnowledge → RAG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;按 SKU 检索规格、说明、政策与适用评价&lt;br&gt;查询向量 → ACL / 时效过滤 → 可选重排&lt;br&gt;返回原文依据 EvidenceBundle；不另起 Agent&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="1705" width="720" height="165" as="geometry"/></mxCell>
<mxCell id="facts" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑤d getProductFacts → 权威事实服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;商品 / 实时价格 / 库存 / 优惠资格 / 可售性&lt;br&gt;返回 EntitySnapshot；只计用户可获得的优惠&lt;br&gt;RAG 与 Memory 不能代替核价&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="1970" width="720" height="165" as="geometry"/></mxCell>
<mxCell id="observe" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑥ Runtime 回填结果 / 保存状态&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;tool_call_id 对应结果、错误、耗时与引用&lt;br&gt;形成新的对话上下文 → 再次请求 LLM&lt;br&gt;可有限补查；工具失败不能声称成功&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="1750" width="740" height="160" as="geometry"/></mxCell>
<mxCell id="progress" value="&lt;b style=&quot;font-size:26px&quot;&gt;全过程｜真实进度与可恢复状态&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;“已找到候选，正在核对价格”&lt;br&gt;“已获取商品资料，正在比较差异”&lt;br&gt;从执行事件产生，不公开模型内部思维链&lt;br&gt;各步骤保存受控状态，不只在结尾落盘&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1670" width="600" height="185" as="geometry"/></mxCell>
<mxCell id="validate" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑦ Runtime 校验比较结论&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;SKU 来源、预算、兼容性、证据型号与有效期&lt;br&gt;缺证据 → 说明不足；矛盾 → 收窄结论&lt;br&gt;修正有预算，不能无限循环&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="2170" width="740" height="160" as="geometry"/></mxCell>
<mxCell id="fallback" value="&lt;b style=&quot;font-size:26px&quot;&gt;异常 / 证据不足｜可解释降级&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;只展示已核验事实或请求补充条件&lt;br&gt;仍不通过则不给未经证实的“性价比最高”&lt;br&gt;模型不可用可回到 App → Domain 短链路&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FCEFEB;strokeColor=#C88178;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="2160" width="600" height="170" as="geometry"/></mxCell>
<mxCell id="reply" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑧ App Reply 流式展示比较与商品卡&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;为什么够用 / 加钱换来什么 / 接受哪些限制&lt;br&gt;正文增量安全处理；结论与关键事实校验后输出&lt;br&gt;商品卡回源核价；价格变化需重筛或告知&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="2440" width="740" height="165" as="geometry"/></mxCell>
<mxCell id="persist" value="&lt;b style=&quot;font-size:26px&quot;&gt;⑨ 会话续问 / 授权反馈&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;本轮条件、候选与排除项写 Memory&lt;br&gt;用户“不要入耳式” → 更新约束并开始下一轮&lt;br&gt;选购结果不是购买授权，购买另走可信交易&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="2720" width="740" height="160" as="geometry"/></mxCell>
<mxCell id="evaluation" value="&lt;b style=&quot;font-size:26px&quot;&gt;事后｜事件 / Trace → 评测与改进&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;约束满足、事实一致、证据忠实、时延与成本&lt;br&gt;曝光与反馈按授权采集，不把点击等同偏好&lt;br&gt;经审核才由 agentControl 发布下一版&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="2720" width="720" height="160" as="geometry"/></mxCell>
<mxCell id="short" value="&lt;b style=&quot;font-size:26px&quot;&gt;保留短链路｜App → Domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;普通筛选 / 分页 / 刷新推荐无需多轮 LLM&lt;br&gt;确定性 Workflow 也可以直接组合搜推能力&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="390" width="720" height="140" as="geometry"/></mxCell>
<mxCell id="legend" value="蓝实线：流程推进 / 服务调用（工具结果原路返回）　绿线：同一 run 内模型循环　灰虚线：事前发布 / 事后闭环　红线：有界降级" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="70" y="2990" width="2440" height="65" as="geometry"/></mxCell>
<mxCell id="boundary" value="&lt;b style=&quot;font-size:26px&quot;&gt;协作要点&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Skill 告诉“怎样做”；Memory 保存“这个用户的上下文”；RAG 提供“外部知识依据”；Tool 实际“查业务系统”。&lt;br&gt;LLM 选择与解释，模型服务提供推理，Runtime 保证受控执行，agentControl 管理版本与上线；任何一层都不能伪造事实或交易授权。&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="3090" width="2400" height="140" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
