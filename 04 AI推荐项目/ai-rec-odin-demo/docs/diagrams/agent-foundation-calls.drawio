<mxCell id="edge-22" value="经审批的构建与发布策略" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8B98A9;strokeWidth=2;fontFamily=PingFang SC;fontSize=19;fontColor=#8B98A9;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="control" target="ingestion"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2090" y="1970"/><mxPoint x="410" y="1970"/></Array></mxGeometry></mxCell>
<mxCell id="title" value="02B / 基础服务依赖展开 · RAG ≠ Memory ≠ 向量数据库" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=34;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="65" y="25" width="2450" height="65" as="geometry"/></mxCell>
<mxCell id="legend" value="蓝线：在线 / 作业内同步调用　紫虚线：异步摄取、事件或发布　箭头均从调用方指向被调用方；分区不是强制部署边界。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#243E5A;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="2450" height="55" as="geometry"/></mxCell>
<mxCell id="rag-callers" value="&lt;b style=&quot;font-size:25px&quot;&gt;RAG 调用方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Runtime → retrieveKnowledge Tool&lt;br&gt;或 search-domain 的知识接口单向委托&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="660" height="115" as="geometry"/></mxCell>
<mxCell id="memory-callers" value="&lt;b style=&quot;font-size:25px&quot;&gt;Memory / 状态调用方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;App：会话读取与管理 API&lt;br&gt;Runtime：上下文、候选引用、检查点与恢复&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="210" width="660" height="115" as="geometry"/></mxCell>
<mxCell id="model-callers" value="&lt;b style=&quot;font-size:25px&quot;&gt;其他模型调用方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Runtime：LLM 生成 / 原生 tool_calls&lt;br&gt;search / rec Domain：编码与专业排序推理&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#64A587;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="210" width="660" height="115" as="geometry"/></mxCell>
<mxCell id="rag-service" value="&lt;b style=&quot;font-size:25px&quot;&gt;RAG 检索服务 / 模块&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;查询改写 → 混合检索 → 重排 → 证据包&lt;br&gt;SKU / ACL / 地域 / 生效时间过滤&lt;br&gt;不负责 Agent 主循环；默认不额外生成答案&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="445" width="660" height="155" as="geometry"/></mxCell>
<mxCell id="memory-service" value="&lt;b style=&quot;font-size:25px&quot;&gt;Memory / 状态服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;账户 + 场景隔离；授权范围、TTL、删除&lt;br&gt;会话 Memory、长期偏好分开管理&lt;br&gt;检查点为持久任务状态，不是模型记忆&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="445" width="660" height="155" as="geometry"/></mxCell>
<mxCell id="model-gateway" value="&lt;b style=&quot;font-size:25px&quot;&gt;模型接入 / 推理平台&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;统一身份、模型版本、配额、超时、熔断&lt;br&gt;LLM / Embedding / Reranker 接口&lt;br&gt;专业排序 Serving 可保留独立端点&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="445" width="660" height="155" as="geometry"/></mxCell>
<mxCell id="knowledge-index" value="&lt;b style=&quot;font-size:25px&quot;&gt;知识检索与索引服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;倒排 + 向量 + metadata / ACL 过滤&lt;br&gt;索引版本、Embedding 版本与维度绑定&lt;br&gt;商品知识索引 ≠ 私人记忆索引&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="825" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="session-store" value="&lt;b style=&quot;font-size:25px&quot;&gt;会话 / 任务持久存储&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;会话消息、约束、候选集引用、run 检查点&lt;br&gt;数据库 / 对象存储为持久依据&lt;br&gt;Redis 作缓存；内存状态不能替代持久恢复&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="825" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="llm-serving" value="&lt;b style=&quot;font-size:25px&quot;&gt;LLM Serving&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;对话生成 / 结构化输出 / tool_calls&lt;br&gt;可受控生成摘要；不直接执行业务 Tool&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="780" width="660" height="125" as="geometry"/></mxCell>
<mxCell id="embedding-serving" value="&lt;b style=&quot;font-size:25px&quot;&gt;Embedding Serving&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;文档 / 查询 / 授权记忆文本 → 向量&lt;br&gt;当前 Demo 示例：远程 bge-m3&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="1010" width="660" height="125" as="geometry"/></mxCell>
<mxCell id="ranking-serving" value="&lt;b style=&quot;font-size:25px&quot;&gt;Reranker / Ranker Serving&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;知识相关性重排；商品召回 / 排序模型&lt;br&gt;两类模型契约不同，不等于 LLM 生成文案&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="1240" width="660" height="125" as="geometry"/></mxCell>
<mxCell id="evidence-store" value="&lt;b style=&quot;font-size:25px&quot;&gt;证据原文 / 版本与元数据&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;官方说明、政策、评价 / 问答与原文引用&lt;br&gt;来源类型、版本、撤回、有效期、实体关联&lt;br&gt;证据片段回给 Runtime，由 LLM 形成解释&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1110" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="preference-store" value="&lt;b style=&quot;font-size:25px&quot;&gt;授权偏好 / 记忆存储&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;来源、时间、用户纠正与删除记录&lt;br&gt;结构化偏好为主；语义检索可选私有向量索引&lt;br&gt;缓存 / 向量索引 / 原文联动失效&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1EDFC;strokeColor=#9880C6;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="1110" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="ingestion" value="&lt;b style=&quot;font-size:25px&quot;&gt;知识摄取 / 索引构建 Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;解析、切分、脱敏、ACL、去重与质量检查&lt;br&gt;调用 Embedding → 建库 / 增量更新&lt;br&gt;评测后发布版本；撤回触发索引与缓存失效&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1460" width="660" height="155" as="geometry"/></mxCell>
<mxCell id="profile" value="&lt;b style=&quot;font-size:25px&quot;&gt;画像 / 行为 / Feature Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;权威行为事实、授权特征与时效&lt;br&gt;推荐 Domain 直接读取；Memory 按授权引用&lt;br&gt;长期偏好不是全量画像副本，推断不当作事实&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CCA062;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="1460" width="660" height="155" as="geometry"/></mxCell>
<mxCell id="realtime" value="&lt;b style=&quot;font-size:25px&quot;&gt;实时商品 / 价格 / 库存服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;App Reply / Tool / Domain 按需批量回源&lt;br&gt;实体卡片、可售性与报价以业务系统为准&lt;br&gt;RAG 与 Memory 都不能代替实时事实&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#FCEFEB;strokeColor=#C88178;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="1460" width="660" height="155" as="geometry"/></mxCell>
<mxCell id="fact-callers" value="&lt;b style=&quot;font-size:25px&quot;&gt;事实调用方｜App Reply / Tool / Domain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;同图 02A；按 skuId 获取权威快照&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#648FC5;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="1660" width="660" height="80" as="geometry"/></mxCell>
<mxCell id="sources" value="&lt;b style=&quot;font-size:25px&quot;&gt;来源系统 / 业务事件&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;商品内容、政策、评价 / 问答更新与撤回&lt;br&gt;授权曝光 / 点击 / 拒绝 / 购买事件&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1780" width="660" height="130" as="geometry"/></mxCell>
<mxCell id="events" value="&lt;b style=&quot;font-size:25px&quot;&gt;事件平台 / 数据加工 / 评测&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Outbox / 消息队列 → 去重、治理、特征更新&lt;br&gt;反馈归因、索引与模型评测、实验分析&lt;br&gt;Telemetry 异步采集；关键审计可靠落盘&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="1780" width="660" height="130" as="geometry"/></mxCell>
<mxCell id="control" value="&lt;b style=&quot;font-size:25px&quot;&gt;agent-control + 配置 / 制品平台&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;审核 Prompt、Skill、Tool、模型与索引版本&lt;br&gt;签名快照异步发布；消费者本地应用&lt;br&gt;权限撤销仍需实时校验或短 TTL 失效&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="1780" width="660" height="130" as="geometry"/></mxCell>
<mxCell id="boundary" value="&lt;b style=&quot;font-size:25px&quot;&gt;调用与数据边界&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;RAG 给外部知识证据，Memory 给本用户上下文，模型服务提供推理，向量库只负责一种检索存储。&lt;br&gt;搜索 / 推荐 / RAG / Memory 的资源命名空间、ACL 与配额独立；向量相似不等于事实正确。&lt;br&gt;离线建库与在线检索分开：生产不在用户首个请求中全量构建索引；本地内存向量库仅适合 Demo 或小规模单实例。&lt;/span&gt;" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#94A3B8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="2040" width="2340" height="160" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
