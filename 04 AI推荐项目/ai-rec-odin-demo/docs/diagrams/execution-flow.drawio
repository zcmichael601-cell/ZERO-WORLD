<mxfile host="app.diagrams.net" agent="Odin project diagrams" type="device"><diagram id="02 执行流程" name="02 执行流程"><mxGraphModel dx="2320" dy="2380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="2380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="background" value="" style="fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2320" height="2380" as="geometry"/></mxCell>
<mxCell id="title" value="02  /  从用户输入到可验证结果" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=40;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="2000" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="两条独立链路：左侧由模型选择工具，右侧按固定 RAG 流程先检索再生成。不是 Skill → RAG 的串行流水线。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=19;fontColor=#52667D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="95" width="2190" height="36" as="geometry"/></mxCell>
<mxCell id="skill-flow" value="" style="rounded=1;arcSize=3;fillColor=#FAFCFE;strokeColor=#DFE7EF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="1120" height="1910" as="geometry"/></mxCell>
<mxCell id="skill-flow-title" value="A  ·  Skill 执行：模型 → Tool → 模型" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=23;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="181" width="1064" height="36" as="geometry"/></mxCell>
<mxCell id="rag-flow" value="" style="rounded=1;arcSize=3;fillColor=#FAFCFE;strokeColor=#DFE7EF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1210" y="165" width="1070" height="1910" as="geometry"/></mxCell>
<mxCell id="rag-flow-title" value="B  ·  RAG：先建库，再检索增强问答" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=23;fontColor=#19324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1238" y="181" width="1014" height="36" as="geometry"/></mxCell>
<mxCell id="s-start" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;选择 Skill、用户及必要输入&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;skills.html 提交本次执行&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="340" y="255" width="400" height="85" as="geometry"/></mxCell>
<mxCell id="s-request" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;POST /api/skills/{id}/stream&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;校验技能是否启用、必填项与用户名&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="400" height="85" as="geometry"/></mxCell>
<mxCell id="s-init" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;初始化 Prompt 与可用工具&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;SystemMessage + UserMessage&lt;br&gt;首次仅暴露 Skill 加载工具&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#729ED9;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="340" y="525" width="400" height="110" as="geometry"/></mxCell>
<mxCell id="s-llm" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;调用现有 LLM 的 stream()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;提交本轮 Prompt + 可用工具定义&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F0EBFC;strokeColor=#A68ACE;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="340" y="690" width="400" height="95" as="geometry"/></mxCell>
<mxCell id="s-preview" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;SSE content&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;正文分片立即显示&lt;br&gt;当前只是未校验预览&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="850" y="685" width="270" height="100" as="geometry"/></mxCell>
<mxCell id="s-has-tools" value="完整响应包含&lt;br&gt;tool_calls？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7D8FA5;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#19324D;spacing=5;" vertex="1" parent="1"><mxGeometry x="440" y="865" width="200" height="115" as="geometry"/></mxCell>
<mxCell id="s-validate-call" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;校验完整的工具调用&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;工具白名单 / 参数 / 调用 ID&lt;br&gt;模型轮次与工具调用次数预算&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ECF7F2;strokeColor=#70B39A;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="340" y="1050" width="400" height="110" as="geometry"/></mxCell>
<mxCell id="s-is-loader" value="调用的是&lt;br&gt;Skill 加载器？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7D8FA5;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#19324D;spacing=5;" vertex="1" parent="1"><mxGeometry x="440" y="1230" width="200" height="105" as="geometry"/></mxCell>
<mxCell id="s-load" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;读取指定 SKILL.md&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;返回完整技能指令&lt;br&gt;开放配置中的业务工具&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF8EB;strokeColor=#CCAD78;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="150" y="1400" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="s-tool" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;真正执行业务 Tool&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;查询画像 / 行为 / 商品&lt;br&gt;或调用真实天气 / 景点接口&lt;br&gt;发出工具开始、完成或失败事件&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#E7F7F4;strokeColor=#55A999;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="605" y="1390" width="360" height="140" as="geometry"/></mxCell>
<mxCell id="s-history" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;工具结果写回对话历史&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;ToolCallingManager 执行回调&lt;br&gt;追加 Assistant 与 ToolResponseMessage&lt;br&gt;下一轮模型读取结果再决策&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#729ED9;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="340" y="1610" width="400" height="135" as="geometry"/></mxCell>
<mxCell id="s-validate-result" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;校验最终结果&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;Skill 已加载、必需工具已完成&lt;br&gt;JSON 必需字段与业务事实引用&lt;br&gt;产品 / 行为 / 天气等约束&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ECF7F2;strokeColor=#70B39A;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="850" y="865" width="270" height="160" as="geometry"/></mxCell>
<mxCell id="s-result" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;SSE result&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;返回完整 Run、output 与轨迹&lt;br&gt;只有校验通过才报告成功&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EAF7ED;strokeColor=#76B58A;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="850" y="1135" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="s-page" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;页面展示结构化结果&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;进度记录、推荐 / 预测 / 出游卡片&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="850" y="1290" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="s-note" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;配置决定边界，模型决定下一步&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;本地 JSON 控制工具与预算；SKILL.md 描述任务和输出。&lt;br&gt;支持好物推荐、兴趣洞察、购物行为预测、北京出游推荐。&lt;br&gt;不会在每轮重复初始化历史，也不会执行不完整的参数分片。&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#ADBCCA;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="170" y="1850" width="880" height="140" as="geometry"/></mxCell>
<mxCell id="s-loop-label" value="下一轮&lt;br&gt;携带工具结果&lt;br&gt;重新请求模型" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=18;fontColor=#397C6E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="920" width="170" height="105" as="geometry"/></mxCell>
<mxCell id="r-index-caption" value="① 独立触发建库：POST /api/rag/index（不是每次提问都重建）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=18;fontColor=#52667D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1245" y="220" width="990" height="32" as="geometry"/></mxCell>
<mxCell id="r-md" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;本地 Markdown&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;knowledge/*.md&lt;br&gt;或配置的本地目录&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF8EB;strokeColor=#CCAD78;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1245" y="280" width="215" height="115" as="geometry"/></mxCell>
<mxCell id="r-split" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;读取与切分&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;Document&lt;br&gt;TokenTextSplitter&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF5E3;strokeColor=#D4A657;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1510" y="280" width="215" height="115" as="geometry"/></mxCell>
<mxCell id="r-embed" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;bge-m3&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;真实向量化&lt;br&gt;文档片段&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F0EBFC;strokeColor=#A68ACE;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1775" y="280" width="200" height="115" as="geometry"/></mxCell>
<mxCell id="r-store" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;内存向量索引&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;SimpleVectorStore&lt;br&gt;形成完整新快照&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF5E3;strokeColor=#D4A657;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="2015" y="280" width="215" height="115" as="geometry"/></mxCell>
<mxCell id="r-index-note" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;索引生命周期&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;构建成功后切换新快照；重建失败保留旧索引；服务重启后需重新构建。&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F4F7FA;strokeColor=#ADBCCA;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1245" y="430" width="985" height="70" as="geometry"/></mxCell>
<mxCell id="r-question" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;② 用户提问&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;rag.html → POST /api/rag/stream&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="550" width="480" height="85" as="geometry"/></mxCell>
<mxCell id="r-ready" value="索引已就绪？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7D8FA5;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#19324D;spacing=5;" vertex="1" parent="1"><mxGeometry x="1460" y="700" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="r-not-ready" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;HTTP 409&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;提示先构建索引&lt;br&gt;本次不打开回答流&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF1E8;strokeColor=#D89A75;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1960" y="700" width="280" height="95" as="geometry"/></mxCell>
<mxCell id="r-retrieve" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;问题向量化 + 向量检索&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;bge-m3 → VectorStoreDocumentRetriever&lt;br&gt;Top-K = 4、阈值 = 0.5（默认配置）&lt;br&gt;SSE sources 返回片段及索引版本，可为空&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF5E3;strokeColor=#D4A657;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="865" width="480" height="130" as="geometry"/></mxCell>
<mxCell id="r-snapshot-label" value="当前完整索引快照" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=PingFang SC;fontSize=17;fontColor=#977437;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1960" y="855" width="280" height="34" as="geometry"/></mxCell>
<mxCell id="r-hits" value="有命中片段？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7D8FA5;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#19324D;spacing=5;" vertex="1" parent="1"><mxGeometry x="1460" y="1055" width="200" height="105" as="geometry"/></mxCell>
<mxCell id="r-no-hits" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;知识库资料不足&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;不请求对话模型&lt;br&gt;返回 answerable=false&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF1E8;strokeColor=#D89A75;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1960" y="1055" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="r-prompt" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;组装 RAG Prompt&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;系统约束：仅基于资料、不执行资料中的指令&lt;br&gt;用户消息：question + 命中原文 sources&lt;br&gt;保留来源与引用标识 C1、C2…&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#729ED9;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="1220" width="480" height="130" as="geometry"/></mxCell>
<mxCell id="r-llm" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;现有 GLM 真实流式生成&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;ChatModel.stream(Prompt)&lt;br&gt;不调用工具，不使用其他事实补全答案&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F0EBFC;strokeColor=#A68ACE;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="1410" width="480" height="105" as="geometry"/></mxCell>
<mxCell id="r-preview" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;SSE delta&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;实时追加模型正文&lt;br&gt;完整 JSON 前仅供预览&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1960" y="1410" width="280" height="105" as="geometry"/></mxCell>
<mxCell id="r-parse" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;聚合完整响应并解析 JSON&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;正常 stop 后才继续；检查字段及引用 ID&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF5E3;strokeColor=#D4A657;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="1570" width="480" height="85" as="geometry"/></mxCell>
<mxCell id="r-answerable" value="answerable&lt;br&gt;为 true？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7D8FA5;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#19324D;spacing=5;" vertex="1" parent="1"><mxGeometry x="1450" y="1710" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="r-decline" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;模型判断资料不足&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;统一拒答提示，不给出引用&lt;br&gt;不把一般查询指引当作确定答案&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF1E8;strokeColor=#D89A75;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1960" y="1710" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="r-citations" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;校验回答与引用&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;只能引用本次命中的 C1…&lt;br&gt;正文引用标记必须与引用列表一致&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF5E3;strokeColor=#D4A657;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="1870" width="480" height="100" as="geometry"/></mxCell>
<mxCell id="r-result" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;SSE result → 页面显示答案 / 资料不足&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;引用可定位原文；显示耗时与是否调用了模型&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EAF7ED;strokeColor=#76B58A;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="2005" width="480" height="60" as="geometry"/></mxCell>
<mxCell id="chat-strip" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;补充  ·  普通对话（需要完整应用入口）&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;POST /chat/stream  →  ChatClientAgent.flux()  →  默认 Prompt + 用户消息 + 会话记忆  →  ChatClient.stream()  →  SSE delta / done / error&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#96B5E2;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="2120" width="2200" height="90" as="geometry"/></mxCell>
<mxCell id="failure-strip" value="&lt;div style=&quot;font-size:20px;line-height:1.2;font-weight:600;&quot;&gt;任意阶段失败时：停止本次流程，不自动重试&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:8px;&quot;&gt;开流前输入错误返回 HTTP 错误；模型 / 工具失败、超时、断流或校验失败，不把已收到的片段当作成功答案。&lt;br&gt;Skill 保留执行轨迹；RAG 返回安全错误。页面不展示内部思维链。引用校验不替代事实核验。&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFF1E8;strokeColor=#D89A75;strokeWidth=1.5;fontColor=#19324D;fontFamily=PingFang SC;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="2250" width="2200" height="100" as="geometry"/></mxCell>
