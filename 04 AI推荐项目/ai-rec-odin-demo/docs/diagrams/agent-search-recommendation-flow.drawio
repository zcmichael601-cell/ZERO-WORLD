<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="AI搜索和AI推荐的执行分工" name="AI搜索和AI推荐的执行分工"><mxGraphModel grid="1" page="1" pageWidth="1900" pageHeight="1610"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;03 / 执行分工：搜索解决“找什么”，推荐解决“对谁、此刻怎么选”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;共享任务状态、候选集合和证据；推荐流可以使用低延迟路径，不要求每次曝光都调用 LLM。&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#AAB9C8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1780" height="110" as="geometry"/></mxCell>
<mxCell id="input" value="&lt;b style=&quot;font-size:24px&quot;&gt;用户：周末北京徒步，500 元以内，轻便防雨；不要我已买过的装备&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;抽取显式约束；不明确的日期/用途先澄清；画像只补充，不覆盖本轮要求&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="185" width="1680" height="105" as="geometry"/></mxCell>
<mxCell id="search" value="&lt;b style=&quot;font-size:24px&quot;&gt;A1 搜索计划｜确定性查询为默认&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;结构化字段 + 关键词/语义改写&lt;br&gt;确需天气/新信息时调用相应 Tool&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="380" width="740" height="110" as="geometry"/></mxCell>
<mxCell id="profile" value="&lt;b style=&quot;font-size:24px&quot;&gt;B1 推荐上下文｜用户授权与当前目标&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;任务向量 + 短期行为 + 长期偏好 + 场景&lt;br&gt;记录来源、时间、置信度与排除项&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F2EDFC;strokeColor=#A28BC8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1050" y="380" width="740" height="110" as="geometry"/></mxCell>
<mxCell id="retrieve" value="&lt;b style=&quot;font-size:24px&quot;&gt;A2 检索与证据获取&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;倒排 + 向量 + 类目属性过滤；RAG 查说明/政策&lt;br&gt;记录 candidateSetId / evidenceRef；不编造 SKU&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="580" width="740" height="120" as="geometry"/></mxCell>
<mxCell id="recall" value="&lt;b style=&quot;font-size:24px&quot;&gt;B2 候选扩展与用户效用排序&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;内容/协同/序列/热门等多路召回&lt;br&gt;排除已购、不适配、不可售；排序系统负责效用估计&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F2EDFC;strokeColor=#A28BC8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1050" y="580" width="740" height="120" as="geometry"/></mxCell>
<mxCell id="evidence" value="&lt;b style=&quot;font-size:24px&quot;&gt;A3 证据是否足够？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;足够则输出；不足时有界改写/补查或澄清&lt;br&gt;高价值复杂比较才启用受限研究子任务&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="790" width="740" height="115" as="geometry"/></mxCell>
<mxCell id="rerank" value="&lt;b style=&quot;font-size:24px&quot;&gt;B3 集合级重排与约束复核&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;多样性、互补性、曝光控制、预算与反感反馈&lt;br&gt;LLM 仅对小候选集补充适配判断/解释，允许弃权&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F2EDFC;strokeColor=#A28BC8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1050" y="790" width="740" height="115" as="geometry"/></mxCell>
<mxCell id="verify" value="&lt;b style=&quot;font-size:24px&quot;&gt;共享：权威实体与实时报价校验&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;读取最终候选的 SKU / 规格 / 价格 / 库存；检查全部硬约束&lt;br&gt;检索证据支持的理由与行为推测分别呈现；不把预测当作已知事实&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CDAC79;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="1030" width="1680" height="120" as="geometry"/></mxCell>
<mxCell id="reply" value="&lt;b style=&quot;font-size:24px&quot;&gt;共享：流式答案 + 可信商品卡 + 下一步&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;支持追问、改条件、换一批、查看来源和关闭个性化&lt;br&gt;购买动作单独进入确认与交易状态机；曝光/点击/拒绝关联本次候选&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#75AA92;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="1240" width="1680" height="120" as="geometry"/></mxCell>
<mxCell id="end" value="&lt;b style=&quot;font-size:24px&quot;&gt;学习闭环：任务成功 / 长期满意 / 事实与安全 / 时延成本 → 分层实验 → 人工审批发布&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;硬约束冲突不静默放宽；搜索零结果不等于没有需求；未曝光商品不能被当作用户不喜欢。&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#AAB9C8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="1450" width="1680" height="95" as="geometry"/></mxCell>
<mxCell id="edge-1" value="显式意图" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.22;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="search"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-2" value="授权个性化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.78;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="profile"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="search" target="retrieve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="retrieve" target="evidence"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="profile" target="recall"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="recall" target="rerank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-7" value="复用候选 / 统一去重" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="retrieve" target="recall"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-8" value="有限补查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="evidence" target="search"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="65" y="847"/><mxPoint x="65" y="435"/></Array></mxGeometry></mxCell>
<mxCell id="edge-9" value="证据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.22;entryY=0;" edge="1" parent="1" source="evidence" target="verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-10" value="排序候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.78;entryY=0;" edge="1" parent="1" source="rerank" target="verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="verify" target="reply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edge-12" value="埋点 / 反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#74889E;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#314F6D;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reply" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
</root></mxGraphModel></diagram></mxfile>
