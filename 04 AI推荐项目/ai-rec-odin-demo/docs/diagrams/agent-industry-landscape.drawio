<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="行业Agent公开架构模式对比" name="行业Agent公开架构模式对比"><mxGraphModel grid="1" page="1" pageWidth="1900" pageHeight="1700"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;01 / 行业 Agent 架构模式对比&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;基于官方公开资料重绘，不是厂商完整生产部署图｜调研日期 2026-10-08&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#AAB9C8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1780" height="110" as="geometry"/></mxCell>
<mxCell id="claude" value="&lt;b style=&quot;font-size:24px&quot;&gt;Claude Code｜执行型 Harness&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;用户任务 → 收集上下文 → 工具行动 → 验证 → 循环&lt;br&gt;CLAUDE.md / Skills / MCP / Subagents / Hooks&lt;br&gt;按需上下文、执行权限与文件检查点&lt;br&gt;边界：文件回退不等于远端业务回滚〔S1–S3〕&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#75AA92;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="870" height="270" as="geometry"/></mxCell>
<mxCell id="codex" value="&lt;b style=&quot;font-size:24px&quot;&gt;Codex｜协议化运行与客户端分离&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;客户端 ↔ App Server ↔ Agent 工作与执行环境&lt;br&gt;Thread / Turn / Item + 流式事件 + 审批&lt;br&gt;AGENTS.md / Skills / MCP / Sandbox&lt;br&gt;边界：借鉴协议；不把实验接口直接当 C 端后端〔S4〕&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF6F0;strokeColor=#75AA92;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="190" width="870" height="270" as="geometry"/></mxCell>
<mxCell id="doubao" value="&lt;b style=&quot;font-size:24px&quot;&gt;豆包助手 API｜托管黑盒能力&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;业务请求 → Responses / 功能选择 → 托管执行 → 回复&lt;br&gt;chat / deep_chat / ai_search / reasoning_search&lt;br&gt;同源能力公开，App 内部调度和存储拓扑未公开&lt;br&gt;当前 API 单功能且不混用自定义工具〔S5〕&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F2EDFC;strokeColor=#A28BC8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="870" height="270" as="geometry"/></mxCell>
<mxCell id="ark" value="&lt;b style=&quot;font-size:24px&quot;&gt;方舟 + Coze｜开放能力与搭建平台&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;方舟搜索：可与函数、MCP 组合的检索工具&lt;br&gt;Coze：Prompt / Plugin / RAG / Workflow 资源与编排&lt;br&gt;二者可以用于建设 Agent，但不是同一套架构&lt;br&gt;更不能据此断言豆包 App 的内部实现〔S6、S7〕&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F2EDFC;strokeColor=#A28BC8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="510" width="870" height="270" as="geometry"/></mxCell>
<mxCell id="research" value="&lt;b style=&quot;font-size:24px&quot;&gt;Claude Research｜研究型多 Agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;LeadResearcher → 并行 Subagents → 汇总 → 引用处理&lt;br&gt;研究计划 / Memory / 迭代搜索 / 恢复与评测&lt;br&gt;适合高价值、可独立拆分的广度研究&lt;br&gt;2025-06 公开快照，不代表全部当前实现〔S8〕&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CDAC79;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="870" height="270" as="geometry"/></mxCell>
<mxCell id="manus" value="&lt;b style=&quot;font-size:24px&quot;&gt;Manus｜上下文与长任务工程&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;模型行动循环 ↔ 工具 / 环境 ↔ 文件与计划&lt;br&gt;稳定前缀、动作约束、大结果外存、保留失败反馈&lt;br&gt;重点披露 Context Engineering，而非完整微服务&lt;br&gt;2025-07 经验文，不据此猜测当前多 Agent 拓扑〔S9〕&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF4E7;strokeColor=#CDAC79;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="830" width="870" height="270" as="geometry"/></mxCell>
<mxCell id="pplx" value="&lt;b style=&quot;font-size:24px&quot;&gt;Perplexity Agent API｜检索工具化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;请求 / Preset → 有界循环 → web_search / fetch_url&lt;br&gt;发现网页与读取正文分离；支持过滤与上下文预算&lt;br&gt;模型读检索结果并形成答案&lt;br&gt;API 文档不能证明消费端内部索引/排序细节〔S10–S12〕&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="870" height="270" as="geometry"/></mxCell>
<mxCell id="rufus" value="&lt;b style=&quot;font-size:24px&quot;&gt;Amazon Rufus｜购物知识 + 实体交付&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;购物问答 → RAG / 商城 API → 领域 LLM → 流式展示&lt;br&gt;商品目录、评价、问答等多源依据&lt;br&gt;展示时查询内部系统填充真实数据（hydration）&lt;br&gt;2024-10 公开设计，不推断其当前下单实现〔S13〕&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#789CCD;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="1150" width="870" height="270" as="geometry"/></mxCell>
<mxCell id="lesson" value="&lt;b style=&quot;font-size:24px&quot;&gt;可迁移的共性：受控循环 + 有效上下文 + 可执行能力 + 证据 / 实体交付 + 评测恢复&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;搜索、推荐、交易仍需各自的领域系统；并非所有请求都需要多 Agent、RAG 或长推理。&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F8FA;strokeColor=#AAB9C8;fontColor=#19324D;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1505" width="1780" height="110" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
